// Block Explosion Damage Configuration
// 
// If server is running while config is changed, use /block_explosion_damage reload
// 
// defaultHitsMultiplier: Multiplier applied to block hardness to calculate required hits.
//   - Higher values = blocks need more hits to break
// 
// damageDecayTime: Time in ticks before damage heals by 1 hit (20 ticks = 1 second)
//   - 6000 ticks = 5 minutes
//   - Note: Can be disabled with /gamerule tntBlockDamageDecay false
// 
// customBlockHits: Override specific blocks to require exact number of hits
//   - Format: "minecraft:block_name": number_of_hits
//   - These override the defaultHitsMultiplier calculation
// 
// protectiveBlocks: Blocks that shield other blocks from explosion damage
//   - Blocks behind these won't take damage from explosions
//   - Format: "minecraft:block_name
// 

{
  "defaultHitsMultiplier": 6.0,
  "damageDecayTime": 460,
  "customBlockHits": {
    "minecraft:glass": 2,
    "minecraft:obsidian": 12,
    "minecraft:crying_obsidian": 12
  },
  "protectiveBlocks": {
    "minecraft:bedrock": true,
    "minecraft:repeating_command_block": true,
    "minecraft:barrier": true,
    "minecraft:chain_command_block": true,
    "minecraft:jigsaw": true,
    "minecraft:command_block": true,
    "minecraft:structure_block": true
  }
}