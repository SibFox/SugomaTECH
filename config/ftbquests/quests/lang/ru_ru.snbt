	quest.37AA831A23C6B6C1.quest_desc: [""]
	quest.37E6C4FC89B3460B.title: "Игрушка Вардена"
	quest.392B56C87AA81411.quest_desc: [
		"Создайте кормушку для динозавров - они будут сами из неё есть."
		""
		"Положите в неё мясо для плотоядных зверей и фрукты и овощи для травоядных."
		""
		"&aЧем больше насыщения у еды, тем больше она даст в копилку."
	]
	quest.392B56C87AA81411.title: "Кормушка для больших кошечек"
	quest.3A3A6C8E836819A5.quest_desc: [
		"Воссоздайте оружие далёкого прошлого... и поместите его в рамочку."
		""
		"Прошлое таит в себе не только эти находки."
	]
	quest.3A3A6C8E836819A5.title: "Древний арсенал"
	quest.3C85B04784D9A0C9.quest_desc: [
		"Продвинутый компьютер обладает большим количеством цветов, чем чёрный и белый."
		"В добавок, позволяет частично пользоваться мышью и добавляет новые удобства в редактирование скриптов и само пользование устройством."
		"Так как появляется возможность открывать дополнительные окна."
	]
	quest.3DC06323A198B1ED.quest_desc: [
		"\"&5Mommy Milkers&r\""
		""
		"Благодаря Инфузеру Плазмидов представляется возможным взаимствовать ДНК других существ."
		""
		"Образуйте уникальную возможность ДНК коровы. А именно давать молоко."
		""
		"Для этого поместите расшифрованное ДНК в Инфузер, а справа поместите пустой плазмид."
	]
	quest.3DC06323A198B1ED.title: "Инфузориев Плазмид"
	quest.3EFCB9E41496FEDC.quest_desc: ["Нажмите семенами по Аметистовому месторождению, чтобы преоброзовать его в Фасоритовое."]
	quest.42AA78336C316D9D.quest_desc: [
		"Предоставляет командный интерфейс между ME Хранилищем и Computer Craft"
		"Wiki: https://docs.advanced-peripherals.de/0.7/peripherals/me_bridge/"
	]
	quest.4464D5FB3CF1299C.quest_desc: [
		"\"Это не обруч\""
		""
		"Плазмид является основой, в которую внедряется ген."
		"Для каждого гена необходимо разное количество ДНК."
	]
	quest.4464D5FB3CF1299C.title: "Гибкий бублик"
	quest.494B41FA52970602.quest_desc: ["Работает как ключ из Create'а, но с содержимым из Oritech'а."]
	quest.494EEDE2CEED89F8.quest_desc: [
		"Станьте свидетелем невообразимого &l&4УЖАСА&r."
		""
		"Погибель &l&4ЭТОГО&r не даст вам путь за пределы..."
	]
	quest.494EEDE2CEED89F8.title: "&l&4ОНО&r владеет небом..."
	quest.4C12691F9BE58D92.quest_desc: [
		"\"Пицца? Нет - Птица!\""
		""
		"Выведите Додо и поглядите на столь чудную птичку."
		""
		"Её ДНК можно найти в вечной мерзлоте под землёй.&8(не обязательно, чтобы было холодно)&r"
	]
	quest.4C12691F9BE58D92.title: "Домашняя п&8(т)&rица"
	quest.4FEB2293B7F43C67.quest_desc: [
		"С помощью этой штуки можно автоматизировать добычу ресурсов."
		"А ещё она зачаровывается, как кирка."
		"&lТребует энергию для работы."
	]
	quest.504FBBF5D2DBD047.quest_desc: [""]
	quest.517A29044FE51A20.quest_desc: [
		"\"...не вымрет.\""
		""
		"Выведите Мамонта и взгляните на легенду."
		""
		"Чтобы вывести это существо, полученный шприц с эмбрионом нужно ввести в любой скот. Из него выйдет &n&m&1нечто&r. Дальше необходимо только подождать."
		""
		"Его ДНК можно найти в вечной мерзлоте под землёй.&8(не обязательно, чтобы было холодно)&r"
	]
	quest.517A29044FE51A20.title: "Лох - не мамонт..."
	quest.51D505EB514577DD.quest_desc: [""]
	quest.51EBBA41108FD69B.quest_desc: [""]
	quest.52106170F10B8579.title: "Игрушка Наездника на Разорителе"
	quest.5246DBF53BF7BAD4.title: "Игрушка Эндермита"
	quest.5AE33DA79E71345B.quest_desc: [
		"Здесь было что-то написано, поэтому мне лень просто убирать этот квест."
		""
		"В основном изучается AE через подсказки у предметов и блоков, но оно всё на английском."
	]
	quest.5AE33DA79E71345B.title: "Старт"
	quest.5F6FFD128C1FC36F.quest_desc: ["Основной компонент для создания электроники."]
	quest.5FB3E03A3D70585F.quest_desc: ["Первый шаг в компьютеризации: Создание первого полноценного компьютера."]
