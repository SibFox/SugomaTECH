	quest.15586B400513DE4B.quest_desc: [
		"''Хотите узнать, из чего Вы состоите??\""
		""
		"Сосклаблив с себя органическую материю, поместите её в Анализатор Клеток."
		""
		"В результате получите свою клетку."
		""
		"Машины запитываются с помощью &4FE&r, поэтому используйте конвертер энергии EF->FE."
	]
